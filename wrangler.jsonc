{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cardcraft",
  "main": "./src/main.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "AI_MODEL": "gemini-3.5-flash-lite",
    "AI_DEMO_MODE": "false",
    "AI_DAILY_LIMIT": "20",
    "ALLOWED_ORIGIN": "*",
    "CARDCRAFT_MONETIZATION_MODE": "demo",
    "CARDCRAFT_PNG_PRICE": "1900",
    "CARDCRAFT_SOURCE_PRICE": "3900",
    "CARDCRAFT_REWARDED_AD_LIVE": "true"
  }
}
